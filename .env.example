# ==============================================================================
# CoWorkFlow Root Environment Variables (Docker & Local Orchestration)
# ==============================================================================

# PostgreSQL Database Configuration
POSTGRES_USER=coworkflow
POSTGRES_PASSWORD=coworkflow_dev_password
POSTGRES_DB=coworkflow
POSTGRES_PORT=5432

# Application Ports
API_PORT=4000
WEB_PORT=3000

# Backend Configuration
DATABASE_URL="postgresql://coworkflow:coworkflow_dev_password@localhost:5432/coworkflow"
JWT_SECRET="dev_jwt_secret_at_least_32_characters_long_super_secure_coworkflow"
CORS_ORIGIN="http://localhost:3000"

# Frontend Configuration
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
